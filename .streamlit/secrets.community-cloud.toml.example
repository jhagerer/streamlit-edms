# Paste into Streamlit Community Cloud → your app → Settings → Secrets.
# (Never commit the real values.)

# Who may run the Setup page (comma-separated login e-mails).
MINIDMS_SETUP_USERS = "you@example.com"

[connections.snowflake]
account   = "myorg-myaccount"
user      = "MINIDMS_SVC"                # a service user with key-pair auth
role      = "MINIDMS_APP"
warehouse = "MINIDMS_WH"
database  = "MY_DB"
schema    = "MINIDMS"
authenticator = "SNOWFLAKE_JWT"
# The unencrypted PKCS#8 key, PEM as-is (the app converts it for the connector):
private_key = """-----BEGIN PRIVATE KEY-----
MIIE...
-----END PRIVATE KEY-----"""

# Login, so every viewer has their own identity (actor, @sessions folder).
# Example: Google as OpenID Connect provider.
[auth]
redirect_uri  = "https://<your-app>.streamlit.app/oauth2callback"
cookie_secret = "<a long random string>"
client_id     = "<client id from Google Cloud Console>"
client_secret = "<client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
