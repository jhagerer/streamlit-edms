# Copy to .streamlit/secrets.toml for local runs (git-ignored).
# Alternatively leave this out and use ~/.snowflake/connections.toml.
[connections.snowflake]
account   = "myorg-myaccount"
user      = "MY_USER"
# Pick ONE authentication method:
authenticator = "externalbrowser"      # SSO in the browser
# password  = "..."
# private_key_file = "/path/to/rsa_key.p8"
role      = "MINIDMS_ROLE"
warehouse = "MY_WH"
database  = "MY_DB"
schema    = "MINIDMS"
